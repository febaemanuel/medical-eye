GEMINI_API_KEY=
VISION_MODEL=gemini-3.8-flash
REPORT_MODEL=gemini-3.8-flash

# Used when running Node directly. Compose uses its internal service address.
WILLIE_URL=http://127.0.0.1:8765/classify
WILLIE_TOKEN=
WILLIE_THREADS=4

# Node binds to loopback by default. Compose publishes loopback only as well.
HOST=127.0.0.1
PORT=4310
